{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ecommerce-business",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": true,
  "routes": [
    { "pattern": "smartzone.pk", "custom_domain": true },
    { "pattern": "www.smartzone.pk", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "INBOX",
      "id": "b90e185fa3ae45f9999c863a2aaeae6f"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      // Cloudflare Email Routing only delivers to verified destinations.
      // Customer mail needs RESEND_API_KEY Worker secret (resend.com).
      "destination_address": "huzaifaqur67@gmail.com"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://sperknmkbyrbmebipnfq.supabase.co"
  }
}
